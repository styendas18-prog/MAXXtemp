# ==============================================================================
# MAXXtemp Configuration (.env.example)
# Copy this file to `.env` (or set these values in your hosting Secrets)
# No AI / Gemini API key is required.
# ==============================================================================

# Server Port (default: 3000)
PORT="3000"

# Public Website URL (used for Telegram ?sync= deep links)
APP_URL="http://localhost:3000"

# Telegram Bot Token from @BotFather (required for Telegram Temp Mail bot)
TELEGRAM_BOT_TOKEN="8747956941:AAEarSsEbzBDG8-j-reaNGTl8hw5zwotP90"

# Optional: Secret header token if using Telegram Webhook mode instead of polling
TELEGRAM_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# Optional Email Forwarding Relay (for 1-click background forwarding)
# Option A: Resend API
# ------------------------------------------------------------------------------
RESEND_API_KEY=""
RESEND_FROM="MAXXtemp Forward <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# Option B: Custom SMTP / Gmail App Password
# ------------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
